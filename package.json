{
  "name": "mermaid-editor",
  "version": "0.1.0",
  "private": true,
  "description": "로그인 없이 쓰는 한국어 Mermaid 다이어그램 에디터",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-pwa.mjs && node scripts/check-pwa.mjs",
    "start": "npx --yes serve@14.2.4 out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mermaid-js/examples": "2.0.0",
    "@mermaid-js/layout-tidy-tree": "1.0.1",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.6.0",
    "mermaid": "12.2.0",
    "monaco-editor": "0.55.1",
    "next": "16.3.5",
    "pako": "2.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "svg-pan-zoom": "3.6.2",
    "svg2roughjs": "3.2.3",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "24.12.0",
    "@types/pako": "2.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3"
  }
}
